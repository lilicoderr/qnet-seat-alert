# 서버 없이 GitHub Actions 로 돌리고 싶을 때의 예시. 이름에서 ".disabled" 를 지우면 활성화됩니다.
# 저장소 Settings → Secrets 에 QNET_DISCORD_WEBHOOK 등을 등록하고, config 는 비밀 없는 JSON 만 커밋하세요.
# 주의: Actions 크론은 최소 5분 간격이며 지연될 수 있습니다. 상태(state.json)는 캐시로 이어 받습니다.
name: qnet-check
on:
  schedule:
    - cron: '*/10 * * * *'
  workflow_dispatch:
jobs:
  check:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '22'
      - uses: actions/cache@v4
        with:
          path: state.json
          key: qnet-state-${{ github.run_id }}
          restore-keys: qnet-state-
      - run: node bin/qnet-alert.js --once --quiet --config config.ci.json
        env:
          QNET_DISCORD_WEBHOOK: ${{ secrets.QNET_DISCORD_WEBHOOK }}

{
  "name": "qnet-seat-alert",
  "version": "1.6.0",
  "private": true,
  "type": "module",
  "description": "Q-Net 원서접수 빈자리(잔여석) 변화를 감지해 Discord/Slack/Telegram 으로 알림 (알림 전용, 자동접수 없음)",
  "bin": {
    "qnet-alert": "bin/qnet-alert.js"
  },
  "scripts": {
    "start": "node bin/qnet-alert.js",
    "once": "node bin/qnet-alert.js --once",
    "test": "node --test",
    "coverage": "node --test --experimental-test-coverage",
    "init": "node bin/qnet-alert.js init",
    "dry": "node bin/qnet-alert.js --dry"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lilicoderr/qnet-seat-alert.git"
  },
  "keywords": [
    "qnet",
    "큐넷",
    "알림",
    "discord",
    "slack",
    "telegram",
    "seat-alert"
  ],
  "license": "MIT"
}

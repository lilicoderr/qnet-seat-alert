{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/lilicoderr/qnet-seat-alert/master/schemas/config.schema.json",
  "title": "qnet-seat-alert config",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "comment": { "type": "string" },
    "plugins": { "type": "array", "items": { "type": "string" }, "description": "Notifier plugin module paths (docs/plugins.md)" },
    "notifiers": {
      "type": "array",
      "description": "Alert channels. Prefer QNET_* environment variables for secrets.",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "type": "string", "description": "discord, slack, telegram, webhook, email, ntfy or a plugin type" },
          "url": { "type": "string" },
          "token": { "type": "string" },
          "chatId": { "type": "string" },
          "host": { "type": "string" },
          "port": { "type": "integer" },
          "secure": { "type": "boolean" },
          "user": { "type": "string" },
          "pass": { "type": "string" },
          "from": { "type": "string" },
          "to": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] },
          "topic": { "type": "string" },
          "server": { "type": "string" }
        }
      }
    },
    "webhookUrl": { "type": "string", "description": "Legacy single Discord webhook" },
    "username": { "type": "string" },
    "intervalMin": { "type": "number", "minimum": 0, "default": 5, "description": "Polling interval in minutes (min 2)" },
    "politeDelayMs": { "type": "number", "minimum": 0 },
    "failureAlertAfter": { "type": "number", "minimum": 0, "default": 5 },
    "parserAlertAfter": { "type": "number", "minimum": 0, "default": 3 },
    "heartbeatHours": { "type": "number", "minimum": 0 },
    "lang": { "enum": ["ko", "en"], "default": "ko", "description": "Language of built-in alert messages" },
    "digest": { "type": "boolean", "default": false },
    "quietHours": {
      "type": "object",
      "required": ["start", "end"],
      "additionalProperties": false,
      "properties": {
        "start": { "type": "string", "pattern": "^([01]?\\d|2[0-3]):[0-5]\\d$" },
        "end": { "type": "string", "pattern": "^([01]?\\d|2[0-3]):[0-5]\\d$" },
        "timezone": { "type": "string", "examples": ["Asia/Seoul"] }
      }
    },
    "rateLimit": {
      "type": "object",
      "required": ["maxPerHour"],
      "additionalProperties": false,
      "properties": { "maxPerHour": { "type": "integer", "minimum": 1 } }
    },
    "templates": { "$ref": "#/definitions/template" },
    "statePath": { "type": "string" },
    "historyPath": { "type": "string" },
    "metricsPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "metricsHost": { "type": "string" },
    "watchers": { "type": "array", "items": { "$ref": "#/definitions/watcher" } }
  },
  "definitions": {
    "template": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "description": "Vars: {name} {available} {applied} {capacity} {signal} {reason} {url} {time}" },
        "description": { "type": "string" }
      }
    },
    "watcher": {
      "type": "object",
      "required": ["url"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "id": { "type": "string" },
        "url": { "type": "string", "pattern": "^https?://" },
        "linkUrl": { "type": "string" },
        "type": { "enum": ["seats", "jsonseats", "contains", "regex"], "default": "seats" },
        "alertOn": { "enum": ["open", "increase", "change", "available"] },
        "alertWhen": { "enum": ["present", "absent", "change"] },
        "include": { "type": "array", "items": { "type": "string" } },
        "exclude": { "type": "array", "items": { "type": "string" } },
        "dateFrom": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "dateTo": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "mention": { "type": "string" },
        "enabled": { "type": "boolean" },
        "needle": { "type": "string" },
        "pattern": { "type": "string" },
        "flags": { "type": "string" },
        "schedule": { "type": "string", "description": "5-field cron (min hour dom month dow), local time; the watcher runs only when due", "examples": ["*/10 9-18 * * 1-5"] },
        "fields": { "type": "object" },
        "method": { "type": "string" },
        "headers": { "type": "object", "additionalProperties": { "type": "string" } },
        "body": { "type": "string" },
        "webhookUrl": { "type": "string" },
        "template": { "$ref": "#/definitions/template" }
      }
    }
  }
}

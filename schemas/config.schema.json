{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/lilicoderr/qnet-seat-alert/master/schemas/config.schema.json",
  "title": "qnet-seat-alert config",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "comment": { "type": "string" },
    "plugins": { "type": "array", "items": { "type": "string" }, "description": "Notifier plugin module paths (docs/plugins.md)" },
    "notifiers": {
      "type": "array",
      "description": "Alert channels. Prefer QNET_* environment variables for secrets.",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "type": "string", "description": "discord, slack, telegram, webhook, email, ntfy or a plugin type" },
          "url": { "type": "string" },
          "token": { "type": "string" },
          "chatId": { "type": "string" },
          "host": { "type": "string" },
          "port": { "type": "integer" },
          "secure": { "type": "boolean" },
          "user": { "type": "string" },
          "pass": { "type": "string" },
          "from": { "type": "string" },
          "to": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] },
          "topic": { "type": "string" },
          "server": { "type": "string" }
        }
      }
    },
    "webhookUrl": { "type": "string", "description": "Legacy single Discord webhook" },
    "username": { "type": "string" },
    "intervalMin": { "type": "number", "minimum": 0, "default": 5, "description": "Polling interval in minutes (min 2)" },
    "politeDelayMs": { "type": "number", "minimum": 0 },
    "failureAlertAfter": { "type": "number", "minimum": 0, "default": 5 },
    "parserAlertAfter": { "type": "number", "minimum": 0, "default": 3 },
    "heartbeatHours": { "type": "number", "minimum": 0 },
    "lang": { "enum": ["ko", "en"], "default": "ko", "description": "Language of built-in alert messages" },
    "digest": { "type": "boolean", "default": false },
    "quietHours": {
      "type": "object",
      "required": ["start", "end"],
      "additionalProperties": false,
      "properties": {
        "start": { "type": "string", "pattern": "^([01]?\\d|2[0-3]):[0-5]\\d$" },
        "end": { "type": "string", "pattern": "^([01]?\\d|2[0-3]):[0-5]\\d$" },
        "timezone": { "type": "string", "examples": ["Asia/Seoul"] }
      }
    },
    "rateLimit": {
      "type": "object",
      "required": ["maxPerHour"],
      "additionalProperties": false,
      "properties": { "maxPerHour": { "type": "integer", "minimum": 1 } }
    },
    "jitter": { "type": "number", "minimum": 0, "maximum": 0.5, "default": 0.1, "description": "Randomize each wait by +/- this fraction of intervalMin" },
    "mentions": {
      "type": "object",
      "additionalProperties": false,
      "description": "Ping people while seats are open. IDs may also come from QNET_MENTION_USERS / QNET_MENTION_ROLES / QNET_MENTION_SLACK.",
      "properties": {
        "users": { "type": "array", "items": { "type": "string", "pattern": "^[0-9]{15,25}$" } },
        "roles": { "type": "array", "items": { "type": "string", "pattern": "^[0-9]{15,25}$" } },
        "slack": { "type": "array", "items": { "type": "string", "pattern": "^[UW][A-Z0-9]{2,20}$" } },
        "cooldownMin": { "type": "number", "minimum": 0, "default": 0 },
        "whileAvailable": { "type": "boolean", "default": true }
      }
    },
    "tableImage": {
      "type": "object",
      "additionalProperties": false,
      "description": "Attach the seat-status table as a PNG (Discord webhook / Telegram). every=true sends it on every check, otherwise only when the table changes.",
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "every": { "type": "boolean", "default": false },
        "chrome": { "type": "string", "description": "Path to Chrome/Chromium/Edge (or QNET_CHROME)" },
        "width": { "type": "number", "minimum": 400, "maximum": 3000, "default": 960 }
      }
    },
    "templates": { "$ref": "#/definitions/template" },
    "statePath": { "type": "string" },
    "historyPath": { "type": "string" },
    "metricsPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "metricsHost": { "type": "string" },
    "watchers": { "type": "array", "items": { "$ref": "#/definitions/watcher" } }
  },
  "definitions": {
    "template": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "description": "Vars: {name} {available} {applied} {capacity} {signal} {reason} {url} {time}" },
        "description": { "type": "string" }
      }
    },
    "watcher": {
      "type": "object",
      "required": ["url"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "id": { "type": "string" },
        "url": { "type": "string", "pattern": "^https?://" },
        "linkUrl": { "type": "string" },
        "type": { "enum": ["seats", "jsonseats", "contains", "regex", "newrows", "qnet"], "default": "seats" },
        "alertOnFirst": { "type": "boolean", "description": "newrows: also alert for entries already present on the first run (default false = baseline silently)" },
        "examPattern": { "type": "string", "description": "qnet: regex on the exam name in the public list, e.g. 기능사" },
        "jongmok": { "type": "string", "description": "qnet: part of the qualification (종목) name, e.g. 건축도장" },
        "region": { "type": "string", "description": "qnet: part of the region (시도) name, e.g. 서울; also filters server-side" },
        "recptCd": { "type": "string", "description": "qnet: applicant type code, default 01 (필기합격자)" },
        "showClosed": { "type": "boolean", "description": "qnet: false = ask only for open venues (cheaper, but the table image is empty when all are full)" },
        "refreshMin": { "type": "number", "description": "qnet: minutes to cache the static steps (default 30)" },
        "maxPages": { "type": "number", "description": "qnet: safety cap of result pages per check (default 5)" },
        "pageDelayMs": { "type": "number", "description": "qnet: pause between result-page requests in ms (default 1500)" },
        "alertOn": { "enum": ["open", "increase", "change", "available"] },
        "alertWhen": { "enum": ["present", "absent", "change"] },
        "include": { "type": "array", "items": { "type": "string" } },
        "exclude": { "type": "array", "items": { "type": "string" } },
        "dateFrom": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "dateTo": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "mention": { "type": "string" },
        "enabled": { "type": "boolean" },
        "needle": { "type": "string" },
        "pattern": { "type": "string" },
        "flags": { "type": "string" },
        "schedule": { "type": "string", "description": "5-field cron (min hour dom month dow), local time; the watcher runs only when due", "examples": ["*/10 9-18 * * 1-5"] },
        "fields": { "type": "object" },
        "method": { "type": "string" },
        "headers": { "type": "object", "additionalProperties": { "type": "string" } },
        "body": { "type": "string" },
        "webhookUrl": { "type": "string" },
        "template": { "$ref": "#/definitions/template" }
      }
    }
  }
}
